{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {
      "@ts-cloud/aws-types": [
        "../aws-types/dist/index.d.ts"
      ],
      "@ts-cloud/aws-types/*": [
        "../aws-types/dist/*"
      ]
    },
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./dist"
  }
}
