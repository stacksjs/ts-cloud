{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "paths": {
      "@ts-cloud/aws-types": [
        "../aws-types/src"
      ],
      "@ts-cloud/aws-types/*": [
        "../aws-types/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "src/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
