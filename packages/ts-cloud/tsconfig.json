{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@ts-cloud/aws-types": [
        "../aws-types/src"
      ],
      "@ts-cloud/aws-types/*": [
        "../aws-types/src/*"
      ],
      "@ts-cloud/core": [
        "../core/src"
      ],
      "@ts-cloud/core/*": [
        "../core/src/*"
      ]
    },
    "types": [
      "bun"
    ],
    "noEmit": true,
    "isolatedDeclarations": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "test/outputs"
  ]
}
