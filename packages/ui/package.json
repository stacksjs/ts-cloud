{
  "name": "@ts-cloud/ui",
  "type": "module",
  "version": "0.12.1",
  "private": true,
  "description": "ts-cloud management dashboard (stx). Served behind HTTP Basic auth.",
  "scripts": {
    "build": "stx build --pages pages --out dist --no-sitemap && bun -e \"require('node:fs').rmSync('dist/partials',{recursive:true,force:true})\"",
    "dev": "stx dev --pages pages"
  },
  "dependencies": {
    "@ts-charts/charts": "^0.2.0",
    "@ts-charts/graph": "^0.2.7"
  },
  "devDependencies": {
    "@stacksjs/stx": "^0.2.194"
  }
}
